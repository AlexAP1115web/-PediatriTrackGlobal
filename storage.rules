rules_version = '2';

// Reglas de seguridad de Firebase Storage para PediatriTrack Global.
// Los PDF se guardan en documentos/{uid}/{archivo}. Solo el usuario
// autenticado dueño de ese uid puede leer, subir o eliminar sus propios
// archivos.

service firebase.storage {
  match /b/{bucket}/o {

    match /documentos/{uid}/{archivo} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      // La app solo permite subir PDF (expo-document-picker con
      // type: "application/pdf"), así que las reglas exigen lo mismo del
      // lado del servidor: evita que alguien use el firebaseConfig público
      // para subir archivos arbitrarios o excesivamente grandes saltándose
      // la app.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType == 'application/pdf'
        && request.resource.size < 15 * 1024 * 1024;
    }

    // Cualquier otra ruta queda bloqueada por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
