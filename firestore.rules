rules_version = '2';

// Reglas de seguridad de Firestore para PediatriTrack Global.
// Cada documento guarda el campo "uid" del usuario que lo creó.
// Solo el dueño autenticado puede leer, actualizar o eliminar su propio
// documento, y solo puede crear documentos marcados con su propio uid.

service cloud.firestore {
  match /databases/{database}/documents {

    // Un update solo se permite si YA eras el dueño y el documento SIGUE
    // perteneciéndote después del cambio (el campo "uid" no se puede
    // reasignar a otra cuenta). Esto evita que alguien "regale" o reasigne
    // sus propios documentos al uid de otra persona.
    function esActualizacionSinCambioDeDueno() {
      return request.auth != null
        && request.auth.uid == resource.data.uid
        && request.resource.data.uid == resource.data.uid;
    }

    match /bebes/{docId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow update: if esActualizacionSinCambioDeDueno();
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
    }

    match /vitaminas/{docId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow update: if esActualizacionSinCambioDeDueno();
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
    }

    match /documentos/{docId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow update: if esActualizacionSinCambioDeDueno();
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
    }

    match /alimentacion/{docId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow update: if esActualizacionSinCambioDeDueno();
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
    }

    match /vacunas_aplicadas/{docId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow update: if esActualizacionSinCambioDeDueno();
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
    }

    // Cualquier otra colección queda bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
